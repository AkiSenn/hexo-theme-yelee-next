<%
  /* 窄屏顶部栏：抽屉入口 + 站名 + 搜索/主题。
     宽屏（≥1080px）只留里面的阅读进度条，其余由 CSS 隐藏 ——
     侧栏已经有站名、搜索与主题开关，顶栏再重复一遍既冗余又突兀。 */
%>
<header class="topbar">
  <button class="topbar__btn" type="button" data-open-sidebar
          aria-label="<%= __('nav.menu') %>" aria-controls="sidebar" aria-expanded="false">
    <%- yn_icon('menu') %>
  </button>
  <a class="topbar__title" href="<%= url_for('/') %>"><%= config.title %></a>
  <div class="topbar__actions">
    <% if (theme.search.enable) { %>
    <button class="icon-btn" type="button" data-open-search aria-label="<%= __('search.title') %>">
      <%- yn_icon('search') %>
    </button>
    <% } %>
    <% if (theme.appearance.theme_switch) { %>
    <button class="icon-btn" type="button" data-toggle-theme aria-label="<%= __('nav.theme') %>">
      <span class="icon-btn__sun"><%- yn_icon('sun') %></span>
      <span class="icon-btn__moon"><%- yn_icon('moon') %></span>
    </button>
    <% } %>
  </div>
</header>
<% if (theme.appearance.reading_progress) { %>
<%# 进度条放在 header **外面**：宽屏时整个顶栏 display:none（避免留下一个空的
    banner landmark），进度条得单独存活下来，所以不能是它的子元素。 %>
<div class="progress" data-progress hidden><span class="progress__bar" data-progress-bar></span></div>
<% } %>
